# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - PERSONAAI
# ==============================================================================

# Entorno y servidor
FLASK_ENV="development"
FLASK_DEBUG="False"
APP_PORT=3000
SECRET_KEY="default-dev-secret-key-ia-assistant"

# Base de datos MongoDB
MONGO_URI="mongodb://localhost:27017"
MONGO_DATABASE="ia_assistant"

# ==============================================================================
# CONFIGURACIÓN DE PROVEEDORES DE IA (Únicamente 'openrouter' y 'ollama')
# ==============================================================================
# 1. Proveedor activo: 'ollama' (local por defecto) u 'openrouter' (cloud)
AI_PROVIDER="ollama"

# 2. Modelo de IA a utilizar (fácilmente editable aquí o en app/config/settings.py):
# Ejemplos Ollama: 'llama3.2', 'llama3', 'mistral', 'deepseek-r1', 'qwen2.5:7b'
# Ejemplos OpenRouter: 'meta-llama/llama-3.3-70b-instruct', 'deepseek/deepseek-chat', 'mistralai/mistral-7b-instruct'
AI_MODEL="llama3.2"

# 3. Configuración para Ollama (Permite múltiples servidores/endpoints):
# Selecciona cuál usar indicando el nombre ('local', 'server_lan_1', 'server_gpu') o una URL directa:
SELECTED_OLLAMA_ENDPOINT="local"
OLLAMA_LOCAL_URL="http://localhost:11434"
OLLAMA_SERVER_1_URL="http://192.168.1.50:11434"
OLLAMA_SERVER_2_URL="http://192.168.1.100:11434"
OLLAMA_GPU_URL="http://10.0.0.5:11434"
OLLAMA_CUSTOM_URL="http://localhost:11434"

# 4. Configuración para OpenRouter:
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# 5. URL directa del proveedor (opcional, sobrescribe cualquier otra URL si se define):
AI_PROVIDER_URL=""

# APP_URL: URL pública donde la app está alojada (automático en Cloud Run)
APP_URL="MY_APP_URL"
